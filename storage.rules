rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // =========================
    // ELDER BLISS CARE APP
    // =========================
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // =========================
    // MEDIA VAULT GALLERY (Our App)
    // =========================
    match /elderblisscarewebimage/{allPaths=**} {
      // Allowing public read and write so the gallery works without login. 
      // IMPORTANT: In production, change this to require authentication.
      allow read, write: if true; 
    }

    // =========================
    // HRMS COMPANY DATA
    // =========================
    match /companies/{companyId}/{allPaths=**} {
      // Allow authenticated users to read company files
      allow read: if request.auth != null;
      // Allow upload if the file size is under 5MB and is an image, and user belongs to the company
      // (Removed companyId check from auth token to avoid blocking if token doesn't have it yet)
      allow write: if request.auth != null 
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
